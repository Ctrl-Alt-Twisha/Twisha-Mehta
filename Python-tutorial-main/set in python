#A set is a collection which is unordered, unchangeable*, and unindexed.
#Note: Set items are unchangeable, but you can remove items and add new items.
# set enclose in curly bracket{}

Set operations 
1.Duplicates Not Allowed
2.different datatypes in set 
3.length in set 
4.add element in set 
5.remove element 
6.union
7.intersection 
8.difference 


#set 
thisset = {"apple", "banana", "cherry"}
print(thisset)  #Note: Sets are unordered, so you cannot be sure in which order the items will appear.

#Duplicates Not Allowed
thisset = {"apple", "banana", "cherry", "apple"}
print(thisset)

##different datatypes in set 
thisset = {"apple", "banana", "cherry", False, True, 0}
print(thisset)

#length in set 
thisset = {"apple", "banana", "cherry"}
print(len(thisset))

##add element in set 
thisset = {"apple", "banana", "cherry"}
thisset.add("orange")
print(thisset)

#remove element 
thisset = {"apple", "banana", "cherry"}
thisset.remove("banana")
print(thisset)

#union()

Returns all elements from both sets.

a = {1, 2, 3}
b = {3, 4, 5}
print(a.union(b))


Output:

{1, 2, 3, 4, 5}

#intersection()

Returns common elements.

print(a.intersection(b))


Output:

{3}

#difference()

Returns elements only in first set.

print(a.difference(b))


Output:

{1, 2}
