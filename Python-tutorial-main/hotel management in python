# -------- GLOBAL VARIABLES --------
room_rent = 0
food_bill = 0

customer_name = ""
phone = ""
address = ""

# -------- CUSTOMER DETAILS --------
def customer_details():
    global customer_name, phone, address
    print("\nENTER CUSTOMER DETAILS")
    customer_name = input("Name: ")
    phone = input("Phone Number: ")
    address = input("Address: ")
    print("Details Saved Successfully")

# -------- ROOM BOOKING --------
def book_room():
    global room_rent
    print("\nROOM TYPES")
    print("1. Single Room  - ₹1000 per day")
    print("2. Double Room  - ₹2000 per day")
    print("3. Deluxe Room  - ₹3000 per day")

    choice = int(input("Select room type (1-3): "))
    days = int(input("Enter number of days: "))

    if choice == 1:
        room_rent = days * 1000
        print("Single Room Booked")

    elif choice == 2:
        room_rent = days * 2000
        print("Double Room Booked")

    elif choice == 3:
        room_rent = days * 3000
        print("Deluxe Room Booked")

    else:
        print("Invalid Room Choice")

# -------- FOOD ORDER --------
def order_food():
    global food_bill
    print("\nFOOD MENU")
    print("1. Breakfast - ₹200")
    print("2. Lunch     - ₹400")
    print("3. Dinner    - ₹500")
    print("4. No Food")

    choice = int(input("Select food option (1-4): "))

    if choice == 1:
        food_bill += 200
        print("Breakfast Ordered")

    elif choice == 2:
        food_bill += 400
        print("Lunch Ordered")

    elif choice == 3:
        food_bill += 500
        print("Dinner Ordered")

    elif choice == 4:
        print("No Food Selected")

    else:
        print("Invalid Food Choice")

# -------- SHOW BILL --------
def show_bill():
    total = room_rent + food_bill

    print("\n========= CUSTOMER BILL =========")
    print("Name       :", customer_name)
    print("Phone      :", phone)
    print("Address    :", address)
    print("--------------------------------")
    print("Room Rent  : ₹", room_rent)
    print("Food Bill  : ₹", food_bill)
    print("Total Bill : ₹", total)
    print("================================")

# -------- MAIN MENU --------
print("WELCOME TO GRAND HOTEL")

while True:
    print("\n------ HOTEL MENU ------")
    print("1. Enter Customer Details")
    print("2. Book Room")
    print("3. Order Food")
    print("4. View Bill")
    print("5. Exit")

    ch = int(input("Enter your choice: "))

    if ch == 1:
        customer_details()

    elif ch == 2:
        book_room()

    elif ch == 3:
        order_food()

    elif ch == 4:
        show_bill()

    elif ch == 5:
        print("THANK YOU! VISIT AGAIN")
        break

    else:
        print("Invalid Choice")
