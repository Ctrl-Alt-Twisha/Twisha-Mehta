Program: Apply all useful lambda functions
numbers = []
n = int(input("How many numbers? "))

for i in range(n):
    num = int(input("Enter number: "))
    numbers.append(num)

print("\nOriginal List:", numbers)

# -------------------------------------
# Basic lambda operations with map()
# -------------------------------------

print("\n--- Map + Lambda Functions ---")

mul2 = list(map(lambda x: x * 2, numbers))
print("Multiply by 2:", mul2)

mul3 = list(map(lambda x: x * 3, numbers))
print("Multiply by 3:", mul3)

add10 = list(map(lambda x: x + 10, numbers))
print("Add 10:", add10)

square = list(map(lambda x: x ** 2, numbers))
print("Square:", square)

cube = list(map(lambda x: x ** 3, numbers))
print("Cube:", cube)

half = list(map(lambda x: x / 2, numbers))
print("Half:", half)

negative = list(map(lambda x: -x, numbers))
print("Negative values:", negative)

to_string = list(map(lambda x: str(x), numbers))
print("Convert to string:", to_string)

# -------------------------------------
# Lambda with filter()
# -------------------------------------

print("\n--- Filter + Lambda Functions ---")

even = list(filter(lambda x: x % 2 == 0, numbers))
print("Even numbers:", even)

odd = list(filter(lambda x: x % 2 != 0, numbers))
print("Odd numbers:", odd)

positive = list(filter(lambda x: x > 0, numbers))
print("Positive numbers:", positive)

negative_numbers = list(filter(lambda x: x < 0, numbers))
print("Negative numbers:", negative_numbers)

# -------------------------------------
# Lambda for sorting
# -------------------------------------

print("\n--- Sorting Using Lambda ---")

asc = sorted(numbers, key=lambda x: x)
print("Ascending:", asc)

desc = sorted(numbers, key=lambda x: -x)
print("Descending:", desc)

# -------------------------------------
# Lambda with reduce()
# -------------------------------------

from functools import reduce

print("\n--- Reduce + Lambda Functions ---")

sum_all = reduce(lambda a, b: a + b, numbers)
print("Sum of all numbers:", sum_all)

product_all = reduce(lambda a, b: a * b, numbers)
print("Product of all numbers:", product_all)

max_num = reduce(lambda a, b: a if a > b else b, numbers)
print("Max number:", max_num)

min_num = reduce(lambda a, b: a if a < b else b, numbers)
print("Min number:", min_num)

