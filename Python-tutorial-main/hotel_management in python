rooms = {
    101: {"type": "Single", "price": 100, "booked": False, "guest": None},
    102: {"type": "Double", "price": 150, "booked": False, "guest": None},
    103: {"type": "Suite", "price": 250, "booked": False, "guest": None}
}

def show_menu():
    print("\n--- Hotel Management System ---")
    print("1. Show available rooms")
    print("2. Book a room")
    print("3. Checkout from a room")
    print("4. Show booked room details")
    print("5. Exit")

def show_available_rooms():
    print("\nAvailable rooms:")
    available = False
    for room_no, details in rooms.items():
        if not details["booked"]:
            print(f"Room {room_no} - {details['type']} - Price: ${details['price']}")
            available = True
    if not available:
        print("No rooms available right now.")

def book_room():
    room_no = int(input("Enter room number to book: "))
    if room_no in rooms:
        if not rooms[room_no]["booked"]:
            guest_name = input("Enter guest name: ")
            nights = int(input("Enter number of nights to stay: "))
            rooms[room_no]["booked"] = True
            rooms[room_no]["guest"] = guest_name
            rooms[room_no]["nights"] = nights
            total_price = rooms[room_no]["price"] * nights
            rooms[room_no]["total_price"] = total_price
            print(f"Room {room_no} successfully booked for {guest_name}.")
            print(f"Total price for {nights} nights: ${total_price}")
        else:
            print(f"Sorry, Room {room_no} is already booked.")
    else:
        print("Invalid room number.")

def checkout_room():
    room_no = int(input("Enter room number to checkout: "))
    if room_no in rooms:
        if rooms[room_no]["booked"]:
            print(f"Room {room_no} checked out from guest {rooms[room_no]['guest']}.")
            rooms[room_no]["booked"] = False
            rooms[room_no]["guest"] = None
            rooms[room_no]["nights"] = None
            rooms[room_no]["total_price"] = None
        else:
            print(f"Room {room_no} is not booked.")
    else:
        print("Invalid room number.")

def show_booked_rooms():
    print("\nBooked room details:")
    booked = False
    for room_no, details in rooms.items():
        if details["booked"]:
            print(f"Room {room_no} - {details['type']} - Guest: {details['guest']}")
            print(f"  Nights: {details.get('nights', 'N/A')}, Total Payment: ${details.get('total_price', 'N/A')}")
            booked = True
    if not booked:
        print("No rooms are currently booked.")

while True:
    show_menu()
    choice = input("Enter your choice: ")

    if choice == "1":
        show_available_rooms()
    elif choice == "2":
        book_room()
    elif choice == "3":
        checkout_room()
    elif choice == "4":
        show_booked_rooms()
    elif choice == "5":
        print("Thank you for using the Hotel Management System!")
        break
    else:
        print("Invalid choice. Please try again.")
