print(thisdict)

#Removing Items
#popitem
The popitem() method removes the last inserted item (in versions before 3.7, a random item is removed instead):

thisdict = {
  "brand": "Ford",
  "model": "Mustang",
  "year": 1964
}
thisdict.popitem()
print(thisdict)

#del keyword 
thisdict = {
  "brand": "Ford",
  "model": "Mustang",
  "year": 1964
}
del thisdict["model"]
print(thisdict)

#clear
thisdict = {
  "brand": "Ford",
  "model": "Mustang",
  "year": 1964
}
thisdict.clear()
print(thisdict)

#copy()
Creates a shallow copy.
student = {"name": "Amit", "age": 21}
new_student = student.copy()
print(new_student)

#fromkeys()
Creates new dictionary with given keys and same value.
keys = ["id", "name", "age"]
new_dict = dict.fromkeys(keys, 0)
print(new_dict)

